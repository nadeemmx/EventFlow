# Production frontend environment template.
# Copy to `.env.production` on the VPS (never commit `.env.production`).
# `next build` FAILS if NEXT_PUBLIC_API_URL is missing, not an absolute
# http(s) URL, or points at localhost/127.0.0.1.
#
# IP mode (current — no domain yet; HTTP is temporary). The API is reverse-
# proxied by nginx on port 80 at path /api/ (deploy/nginx/eventflow-ip.conf
# → gunicorn 127.0.0.1:8000), so no port is appended here:
NEXT_PUBLIC_API_URL=http://194.77.89.95/api/v1
NEXT_PUBLIC_APP_URL=http://194.77.89.95
#
# Domain mode (final — when DNS records and a TLS certificate exist):
# NEXT_PUBLIC_API_URL=https://api.YOUR-DOMAIN/api/v1
# NEXT_PUBLIC_APP_URL=https://www.YOUR-DOMAIN
