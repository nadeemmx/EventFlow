# ===========================================
# EventFlow Production Environment Variables
# ===========================================

# REQUIRED: Django secret key (50+ chars, random)
DJANGO_SECRET_KEY=

# REQUIRED: Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=api.eventflow.com,app.eventflow.com

# REQUIRED: Redis URL for cache, throttle, brute-force protection
REDIS_URL=redis://127.0.0.1:6379/0

# REQUIRED: AES-256-GCM encryption key for EncryptedTextField
# Generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# Database (MySQL/MariaDB)
DB_NAME=eventflow
DB_USER=eventflow
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CSRF trusted origins (comma-separated full origins)
CSRF_TRUSTED_ORIGINS=https://app.eventflow.com,https://api.eventflow.com

# Email (optional - falls back to console if not set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@eventflow.com

# Sentry (optional)
SENTRY_DSN=

# JWT token lifetimes in minutes (optional, defaults: access=60, refresh=1440)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
