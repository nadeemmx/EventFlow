# EventFlow Mobile — Environment Configuration
#
# ===========================================================================
#  IMPORTANT: this file is DOCUMENTATION ONLY. It is NOT loaded by the app.
# ===========================================================================
#
# `flutter_dotenv` is deliberately NOT a dependency of this project, and no
# Dart code reads a `.env` file. Copying this file to `.env` has no effect.
# It exists so you know which values to supply and HOW to supply them.
#
# All overridable values are compile-time `String.fromEnvironment` constants,
# so they are passed with `--dart-define` at BUILD time, e.g.:
#
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1/ \
#     --dart-define=APP_ENV=development
#
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
# Single source of truth: lib/core/config/app_config.dart -> AppConfig.apiBaseUrl
# Consumed by ApiEndpoints.baseUrl. Override with --dart-define=API_BASE_URL.
#
# Value MUST end with "/" (the app normalises this, but be explicit).
#
#   Android emulator -> backend on host machine: http://10.0.2.2:8000/api/v1/
#   iOS simulator    -> backend on host machine: http://127.0.0.1:8000/api/v1/
#   Production (IP mode, current — no domain yet):
#     flutter build apk --release --dart-define=API_BASE_URL=http://194.77.89.95/api/v1/
#   Production (domain mode, final):
#     flutter build apk --release --dart-define=API_BASE_URL=https://api.YOUR-DOMAIN/api/v1/
#
API_BASE_URL=http://194.77.89.95/api/v1/

# --- App environment -------------------------------------------------------
# One of: development | staging | production. Defaults to "production".
APP_ENV=production

# --- Push notifications (Firebase) -----------------------------------------
# REQUIRED before push can work. Firebase is currently stubbed at runtime:
# see lib/core/services/notification_service.dart -- if these files are
# absent the app runs normally and push is a silent no-op (it will NOT crash).
#
# To enable push, drop the real project config files in place:
#
#   Android: mobile_app/android/app/google-services.json
#            (must match applicationId com.eventflow.eventflow_app)
#   iOS:     mobile_app/ios/Runner/GoogleService-Info.plist
#            (must match bundle id com.eventflow.eventflowApp)
#
# These files contain real project identifiers and must NOT be committed if
# your policy forbids it -- they are gitignored by default. Obtain them from
# the Firebase console. NEVER invent placeholder values: a fake config file
# is worse than none, because it turns a clean no-op into a runtime crash.
#
# NOTE: these Dart-side keys are informational only; Firebase reads its
# config from the native files above, not from --dart-define.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=

# --- Payments (Razorpay) ---------------------------------------------------
# KNOWN GAP (not part of Tier-1 fixes): razorpay_flutter is a dependency and
# AppConfig.razorpayKeyId is declared, but the Razorpay SDK is never
# initialised anywhere in lib/ and no checkout page exists. In-app payment
# collection is display-only today. Supplying this key will not change that.
RAZORPAY_KEY_ID=
