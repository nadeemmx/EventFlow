# EventFlow Media - .htaccess for public_html/media/
# Place this in the media directory

Options -Indexes

# Allow direct access to media files
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# File upload size limit
LimitRequestBody 10485760

# Only allow specific file types (case-insensitive)
<FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|pdf)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block all potentially dangerous file types
<FilesMatch "(?i)\.(php|php[0-9s]*|phtml|pht|phps|cgi|pl|py|asp|aspx|jsp|sh|bash|exe|bat|cmd|com|msi|scr|vbs|vbe|js|wsf|wsc|wsh|ps1|psm1|reg|dll|bat|cmd|com|msp|hta|cpl|lnk|inf|reg|rgs|sct|shb|shs|wor|ws)$">
    Deny from all
</FilesMatch>
