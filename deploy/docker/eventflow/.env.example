# ==========================================================================
# EventFlow — Compose environment file (TEMPLATE / placeholders only)
# ==========================================================================
# The real file lives OUTSIDE the repository on the VPS:
#     /srv/baseify/eventflow/.env      (owner: deploy user, mode 0600)
# It is passed to compose via --env-file and is NEVER committed, never
# copied into images and never printed. bootstrap_vps.sh generates it with
# server-side randomness — this template only documents the keys.
#
# Every value below is a placeholder. Generation hints:
#   DJANGO_SECRET_KEY : openssl rand -hex 32
#   ENCRYPTION_KEY    : openssl rand -base64 32
#   DB_PASSWORD /
#   REDIS_PASSWORD    : openssl rand -hex 24
# ==========================================================================

# ---- Django ---------------------------------------------------------------
# REQUIRED. Never reuse a development key.
DJANGO_SECRET_KEY=CHANGE_ME_django_secret_key_50_plus_chars

# REQUIRED. AES key for EncryptedTextField (base64 of 32 random bytes).
ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key

# REQUIRED. Comma-separated hosts. IP-only HTTP test setup:
DJANGO_ALLOWED_HOSTS=194.77.89.95,localhost,127.0.0.1

# Comma-separated full origins (scheme://host[:port]).
CSRF_TRUSTED_ORIGINS=http://194.77.89.95
CORS_ALLOWED_ORIGINS=http://194.77.89.95

# ---- HTTP/IP test mode (TEMPORARY — see docs/DOCKER_DEPLOYMENT.md) -------
# false = cookies work over plain http://194.77.89.95. When a domain with
# HTTPS exists, set ALL THREE to true and restore full HSTS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_PRELOAD=false

# ---- Database (MariaDB container; host/user/name have safe defaults) -----
DB_NAME=eventflow
DB_USER=eventflow
DB_PASSWORD=CHANGE_ME_db_password

# ---- Redis (cache / throttle / brute-force protection) -------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- Frontend build input (NOT a secret; inlined into the JS bundle) -----
NEXT_PUBLIC_API_URL=http://194.77.89.95/api/v1

# ---- Email (leave empty to log to console instead of sending) ------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@eventflow.com

# ---- Optional integrations ----------------------------------------------
SENTRY_DSN=
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ---- Compose / host paths ------------------------------------------------
# Image tag = deployed commit SHA (set by deploy_compose.sh; do not edit).
EVENTFLOW_TAG=local
# Host directory bind-mounted as MEDIA_ROOT (/home/eventflow/media) in the
# backend (rw) and nginx (ro). Lives outside the git checkout.
EVENTFLOW_MEDIA_DIR=/srv/baseify/eventflow/media
